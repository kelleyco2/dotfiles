[alias]
    gbr = !git branch | grep -v \"master\" | xargs git branch -D
    ac = !git add . && git commit -m
    cob = !git checkout -b
    ammend = !git commit --amend -m
    c = !git checkout
    unlock = !rm -f \"$(git rev-parse --git-dir)/index.lock\" && echo unlocked
    pwl = !git push --force-with-lease
    quickfix = !git add . && git commit --amend --no-edit
		reset = !git reset --soft HEAD~1
		build = !git commit --allow-empty -m "build" && git push
[merge]
	conflictstyle = diff3
[user]
	signingkey = 60063DC12E49C697DFD17276A6D2F7FAE40F1299
	email = cooper.kelley@pdq.com
[commit]
	gpgsign = true
[tag]
	gpgsign = true
[push]
	autoSetupRemote = true
[status]
	showUntrackedFiles = all
[gpg]
	program = /opt/homebrew/bin/gpg
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
