#!/usr/bin/env bash
# Session hub: one fzf picker over running tmux sessions and launchable projects.
#
# Running sessions show Claude's state in their `claude` window:
#   ● waiting  (green)  — Claude is idle, waiting for your input  ← sorted on top
#   ● working  (amber)  — Claude is actively producing output
#   ●          (gray)   — session running, Claude not in its window
#   ○          (dim)    — project not running; Enter launches a smug session
#
# Enter switches into a running session, or launches one for a project, and
# jumps in. Works inside or outside tmux. Fast: only two tmux calls per open.

set -euo pipefail

TAB=$'\t'
CLAUDE_WIN="claude" # window name our smug templates use for Claude

# ---- preview mode (invoked by fzf as: hub --preview <line>) ------------------
if [[ "${1:-}" == "--preview" ]]; then
  line=${2:-}
  act=$(printf '%s' "$line" | cut -f2)
  arg=$(printf '%s' "$line" | cut -f3)
  # A launchable project is a path; a running session resolves to its cwd.
  if [[ "$act" == switch ]]; then
    dir=$(tmux list-panes -t "=$arg:$CLAUDE_WIN" -F '#{pane_current_path}' 2>/dev/null | head -1 || true)
    [[ -n "$dir" ]] || dir=$(tmux list-panes -t "=$arg" -F '#{pane_current_path}' 2>/dev/null | head -1 || true)
  else
    dir=$arg
  fi
  [[ -n "${dir:-}" && -d "$dir" ]] || exit 0

  if git -C "$dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    branch=$(git -C "$dir" rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?')
    dirty=$(git -C "$dir" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
    ab=""
    if git -C "$dir" rev-parse --abbrev-ref '@{u}' >/dev/null 2>&1; then
      set -- $(git -C "$dir" rev-list --left-right --count '@{u}...HEAD' 2>/dev/null || echo '0 0')
      if [[ "${2:-0}" != 0 ]]; then ab+=" ↑${2}"; fi
      if [[ "${1:-0}" != 0 ]]; then ab+=" ↓${1}"; fi
    fi
    printf '\033[35m %s\033[0m%s  \033[38;5;240m%s changed\033[0m\n\n' "$branch" "$ab" "$dirty"
    if [[ "$dirty" != 0 ]]; then
      git -C "$dir" -c color.status=always status -s 2>/dev/null | head -14 || true
      stat=$(git -C "$dir" diff HEAD --shortstat 2>/dev/null | sed 's/^ *//')
      if [[ -n "$stat" ]]; then printf '\033[38;5;240m%s\033[0m\n' "$stat"; fi
    else
      printf '\033[38;5;240m✓ working tree clean\033[0m\n'
    fi
    printf '\n\033[38;5;238m── recent ──────────\033[0m\n\n'
    git -C "$dir" -c color.ui=always log -6 \
      --format='%C(yellow)%h %C(238)%ar%Creset %s' 2>/dev/null || true
  else
    eza --tree --icons --level 2 --git-ignore "$dir" 2>/dev/null || ls -1 "$dir"
  fi
  exit 0
fi

inside_tmux() { [[ -n "${TMUX:-}" ]]; }

ACTIVE_SECS=5 # output within this many seconds counts as "working"
now=$(date +%s)

# Two tmux calls total: running session names, and all panes (for Claude state).
running=$(tmux list-sessions -F '#{session_name}' 2>/dev/null || true)
panes=$(tmux list-panes -a \
  -F '#{session_name}|#{window_name}|#{pane_current_command}|#{window_activity}' 2>/dev/null || true)

NL=$'\n'
is_running() { [[ "$NL$running$NL" == *"$NL$1$NL"* ]]; }
is_shell() { case "$1" in zsh | bash | fish | sh | -zsh | -bash) return 0 ;; *) return 1 ;; esac; }

# ANSI 256 colours
g() { printf '\033[38;5;%sm%s\033[0m' "$1" "$2"; } # g <color> <text>

# Buckets so we can order: waiting → working → idle → projects.
waiting=""
working=""
idle=""
projects=""

# Classify each running session by its claude window's command + activity.
for sess in $running; do
  [[ -n "$sess" ]] || continue
  cmd=""
  act=""
  while IFS='|' read -r s w c a; do
    if [[ "$s" == "$sess" && "$w" == "$CLAUDE_WIN" ]]; then
      cmd=$c
      act=$a
      break
    fi
  done <<< "$panes"

  if [[ -z "$cmd" ]] || is_shell "$cmd"; then
    line="$(g 244 ●) $sess${TAB}switch${TAB}$sess"$'\n'
    idle+="$line"
  elif [[ -n "$act" && $((now - act)) -le $ACTIVE_SECS ]]; then
    line="$(g 214 ●) $sess  $(g 240 working)${TAB}switch${TAB}$sess"$'\n'
    working+="$line"
  else
    line="$(g 42 ●) $sess  $(g 42 waiting)${TAB}switch${TAB}$sess"$'\n'
    waiting+="$line"
  fi
done

# Launchable projects (skip any already running). No per-dir subprocess.
dirs=("$HOME/dotfiles")
JOURNAL="$HOME/Journal/$(date +%Y)"
[[ -d "$JOURNAL" ]] && dirs+=("$JOURNAL")
dirs+=("$HOME"/Code/*/)
for d in "${dirs[@]}"; do
  d=${d%/}
  [[ -d "$d" ]] || continue
  name=${d##*/}
  name=${name//./_}
  is_running "$name" && continue
  projects+="$(g 240 ○) $name${TAB}start${TAB}$d"$'\n'
done

HEADER="$(g 42 ●) waiting   $(g 214 ●) working   $(g 240 ○) launch"
SEL=$(printf '%s' "$waiting$working$idle$projects" | fzf \
  --ansi --delimiter="$TAB" --with-nth=1 \
  --header="$HEADER" --header-first \
  --prompt="🔮 " \
  --preview "'$0' --preview {}" \
  --preview-window=right,55%) || exit 0
[[ -n "$SEL" ]] || exit 0

ACTION=$(printf '%s' "$SEL" | cut -f2)
ARG=$(printf '%s' "$SEL" | cut -f3)

case "$ACTION" in
  switch)
    if inside_tmux; then tmux switch-client -t "=$ARG"; else tmux attach -t "=$ARG"; fi
    ;;
  start)
    name=${ARG##*/}
    name=${name//./_}
    ATTACH=""
    inside_tmux && ATTACH="-a"
    # shellcheck disable=SC2086
    smug start "$name" $ATTACH 2>/dev/null || smug start default name="$name" root="$ARG" $ATTACH
    ;;
esac
